    rdfs:subClassOf <http://example.org/doctrine/Joint_Operations_20260929T011743Z_r0#Entity>,
        <http://example.org/doctrine/Joint_Operations_20260929T011743Z_r0#ResponsibleEntity> ;
    skos:prefLabel "Organization"@en .

<http://example.org/doctrine/Joint_Operations_20260929T011743Z_r0#Activity> a owl:Class ;
    rdfs:label "Activity"@en ;
    rdfs:comment "범주 개념이므로 tbox"@ko ;
    skos:prefLabel "Activity"@en .

<http://example.org/doctrine/Joint_Operations_20260929T011743Z_r0#Commander> a owl:Class ;
    rdfs:label "Commander"@en ;
    rdfs:comment "Conceptual class for a person in a command role."@en ;
    rdfs:subClassOf <http://example.org/doctrine/Joint_Operations_20260929T011743Z_r0#Leader>,
        <http://example.org/doctrine/Joint_Operations_20260929T011743Z_r0#MilitaryLeader>,
        <http://example.org/doctrine/Joint_Operations_20260929T011743Z_r0#Person>,
        <http://example.org/doctrine/Joint_Operations_20260929T011743Z_r0#Personnel> ;
    skos:prefLabel "Commander"@en .

<http://example.org/doctrine/Joint_Operations_20260929T011743Z_r0#Document> a owl:Class ;
    rdfs:label "Document"@en ;
    skos:prefLabel "Document"@en .

<http://example.org/doctrine/Joint_Operations_20260929T011743Z_r0#OperationalArt> a owl:Class ;
    rdfs:label "Operational Art"@en ;
    rdfs:comment "작전술이라는 군사 교리적 개념임"@ko ;
    skos:prefLabel "Operational Art"@en .

<http://example.org/doctrine/Joint_Operations_20260929T011743Z_r0#JFC> a owl:Class ;
    rdfs:label "Joint Force Commander"@en ;
    rdfs:comment "Joint Force Commander의 약어로, 일반적으로 지휘관이라는 개념적 클래스로 사용됨"@ko ;
    rdfs:subClassOf <http://example.org/doctrine/Joint_Operations_20260929T011743Z_r0#Actor>,
        <http://example.org/doctrine/Joint_Operations_20260929T011743Z_r0#Commander>,
        <http://example.org/doctrine/Joint_Operations_20260929T011743Z_r0#DesignatedCommander>,
        <http://example.org/doctrine/Joint_Operations_20260929T011743Z_r0#JointForce>,
        <http://example.org/doctrine/Joint_Operations_20260929T011743Z_r0#Organization> ;
    skos:prefLabel "Joint Force Commander"@en .

