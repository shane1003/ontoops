<http://example.org/doctrine/Joint_Operations_20260929T011743Z_r0#JointForce> a owl:Class ;
    rdfs:label "Joint Force"@en ;
    rdfs:subClassOf <http://example.org/doctrine/Joint_Operations_20260929T011743Z_r0#Force>,
        <http://example.org/doctrine/Joint_Operations_20260929T011743Z_r0#Organization> ;
    skos:prefLabel "Joint Force"@en .

<http://example.org/doctrine/Joint_Operations_20260929T011743Z_r0#Force> a owl:Class ;
    rdfs:label "Force"@en ;
    rdfs:comment "Military force as a conceptual category."@en ;
    rdfs:subClassOf <http://example.org/doctrine/Joint_Operations_20260929T011743Z_r0#ArmedForce> ;
    skos:prefLabel "Force"@en .

<http://example.org/doctrine/Joint_Operations_20260929T011743Z_r0#Organization> a owl:Class ;
