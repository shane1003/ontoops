    rdfs:domain <http://example.org/doctrine/Operations_20260929T011743Z_r0#Asset> ;
    rdfs:range <http://example.org/doctrine/Operations_20260929T011743Z_r0#Mission> ;
    skos:prefLabel "accomplishes Mission"@en .

