<http://example.org/doctrine/Operations_20260929T011743Z_r0#acceptsPrudentRisk> a owl:DatatypeProperty ;
    rdfs:label "accepts Prudent Risk"@en ;
    rdfs:comment "Characteristic of Mission Command."@en ;
    rdfs:domain <http://example.org/doctrine/Operations_20260929T011743Z_r0#MissionCommand> ;
    rdfs:range xsd:string ;
    skos:prefLabel "accepts Prudent Risk"@en .

<http://example.org/doctrine/Operations_20260929T011743Z_r0#acceptsRisk> a owl:ObjectProperty ;
    rdfs:label "accepts Risk"@en ;
    rdfs:comment "Action of accepting risk."@en ;
    rdfs:domain [ a owl:Class ;
            owl:unionOf ( <http://example.org/doctrine/Operations_20260929T011743Z_r0#MissionCommand> <http://example.org/doctrine/Operations_20260929T011743Z_r0#Operation> <http://example.org/doctrine/Operations_20260929T011743Z_r0#UnifiedLandOperation> ) ] ;
    rdfs:range [ a owl:Class ;
            owl:unionOf ( <http://example.org/doctrine/Operations_20260929T011743Z_r0#Risk> <http://example.org/doctrine/Operations_20260929T011743Z_r0#PrudentRisk> ) ] ;
    skos:prefLabel "accepts Risk"@en .

<http://example.org/doctrine/Operations_20260929T011743Z_r0#acceptsRiskAt> a owl:ObjectProperty ;
    rdfs:label "accepts Risk At"@en ;
    rdfs:domain <http://example.org/doctrine/Operations_20260929T011743Z_r0#Commander> ;
    rdfs:range <http://example.org/doctrine/Operations_20260929T011743Z_r0#RiskLocation> ;
    skos:prefLabel "accepts Risk At"@en .

<http://example.org/doctrine/Operations_20260929T011743Z_r0#accomplishedBy> a owl:ObjectProperty ;
    rdfs:label "accomplished By"@en ;
    rdfs:comment "Relates a mission to the force executing it."@en ;
    rdfs:domain <http://example.org/doctrine/Operations_20260929T011743Z_r0#Mission> ;
    rdfs:range <http://example.org/doctrine/Operations_20260929T011743Z_r0#Force> ;
    skos:prefLabel "accomplished By"@en .

<http://example.org/doctrine/Operations_20260929T011743Z_r0#accomplishes> a owl:ObjectProperty ;
    rdfs:label "accomplishes"@en ;
    rdfs:comment "Inverse of accomplishedBy."@en ;
    rdfs:domain [ a owl:Class ;
            owl:unionOf ( <http://example.org/doctrine/Operations_20260929T011743Z_r0#Force> <http://example.org/doctrine/Operations_20260929T011743Z_r0#Operation> <http://example.org/doctrine/Operations_20260929T011743Z_r0#LeadershipProcess> <http://example.org/doctrine/Operations_20260929T011743Z_r0#Commander> ) ] ;
    rdfs:range <http://example.org/doctrine/Operations_20260929T011743Z_r0#Mission> ;
    skos:prefLabel "accomplishes"@en .

<http://example.org/doctrine/Operations_20260929T011743Z_r0#accomplishesMission> a owl:ObjectProperty ;
