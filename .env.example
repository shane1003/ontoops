# The one configuration file of the stack and the evaluation code. Copy it
# to .env (git-ignored) and set section 1 for your machine (SETUP.md). docker
# compose and the evaluation code both read .env; no service reads a
# configuration file of its own.
#
# Two parts:
#   1. Machine: addresses, ports, keys. Set these for your machine.
#   2. Stack settings: the production values every experiment runs with.
#      `evaluation envcheck` fails when .env differs from this file here, and
#      every run records the values in its manifest. A deliberate deviation is
#      an edit to this file (tracked) plus a row in the SETUP.md table.

# ---------------------------------------------------------------------------
# 1. Machine
# ---------------------------------------------------------------------------

# Stack database password. The stack binds to 127.0.0.1 only, so the default
# is fine for a local run.
POSTGRES_PASSWORD=change-me

# LLM servers: OpenAI-compatible endpoints, left empty here; fill them in for
# your machine. A local server (vLLM, llama.cpp, ...) or an external,
# OpenAI-compatible provider both work. The experiments of the paper ran on
# local servers only. Both served google/gemma-4-31B-it, with different
# settings, so the stack keeps them apart:
#   CQ generation: max_model_len 16384, reasoning parser gemma4
#   ontoagent:     max_model_len 32768, served as "local-model"
# Use an address the containers can reach: the host's LAN address, or
# host.docker.internal for a server published on all host interfaces, e.g.
# http://host.docker.internal:8000/v1 (ONTOAGENT_LLM_ROOT_URL is the same
# server without /v1).
CQGEN_LLM_BASE_URL=
CQGEN_LLM_MODEL=google/gemma-4-31B-it
ONTOAGENT_LLM_BASE_URL=
ONTOAGENT_LLM_ROOT_URL=
ONTOAGENT_LLM_MODEL=local-model

# GPU index for the embedding server.
TEI_GPU=0

# Host ports (127.0.0.1 only). Change if they collide with something else.
POSTGRES_PORT=55432
FALKORDB_PORT=56379
CQGEN_PORT=8081
ONTOAGENT_PORT=8082
ONTOROUTER_PORT=8083

# Optional: the Anthropic API key of the faithfulness judge (experiment 4).
ANTHROPIC_API_KEY=

# ---------------------------------------------------------------------------
# 2. Stack settings (production values; see SETUP.md for each deviation)
# ---------------------------------------------------------------------------

# Embedding server: same model, revision and precision as production.
EMBEDDING_MODEL_ID=intfloat/multilingual-e5-large-instruct
EMBEDDING_REVISION=main
EMBEDDING_DTYPE=float16

# CQ generation: target characters per paragraph chunk.
CQ_CHUNK_CHAR_BUDGET=1500
# CQ generation output cap.
CQ_GENERATOR_MAX_TOKENS=8192

# ontoagent: production judges terms against the military domain.
CONCEPTUALIZER_DOMAIN=military
# ontoagent: production concurrency after the 2026-08 tuning.
CONCEPTUALIZER_CHUNK_CONCURRENCY=32
TBOXCRAFT_VERIFY_CONCURRENCY=16
TBOXCRAFT_REASONER_ENABLED=true
# Deviation: OOPS! is an advisory pitfall scanner with no service in this stack.
TBOXCRAFT_OOPS_ENABLED=false

# ontorouter: the lexical index is an in-memory copy refreshed on this
# interval. Deviation (production: 300 s): a probe right after a cell would
# find the new terms missing, so the stack refreshes faster and the runner
# waits past it before probing.
KEY_INDEX_REFRESH_INTERVAL_S=30
