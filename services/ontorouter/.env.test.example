# ontorouter — config template. Copy to .env.test and fill in your own values.
# Nothing is hardcoded in code; every setting below is read from the
# environment (SSOT). Every key is optional — the default in the comment is
# what app/core/config.py falls back to — but the Postgres block must point at
# a real store for the service to answer anything.
#
# Never commit a filled-in copy: .env.test is gitignored, this file is not.

# --- Postgres: the live store holding public.tbox_term / public.surface_form
#     and ontorouter's own schema. Read-only on public; ontorouter writes only
#     to the ontorouter schema (see db/ddl/001_ontorouter_schema.sql).
POSTGRES_HOST=127.0.0.1          # default: localhost
POSTGRES_PORT=5432               # default: 5432
POSTGRES_DBNAME=changeme         # default: postgres
POSTGRES_USER=changeme           # default: postgres
POSTGRES_PASSWORD=               # default: empty — fill in, never commit


# --- Embedding (TEI, e5). Both keys are required to enable the semantic
#     suggestion tier; leaving either unset is a normal degraded state in
#     which /lookup still serves results and lexical suggestions.
EMBED_URL=                       # default: unset — e.g. http://127.0.0.1:8801
EMBEDDING_MODEL_ID=              # default: unset — e.g. intfloat/multilingual-e5-large-instruct
EMBED_TIMEOUT_S=5.0              # default: 5.0 — timeout per TEI call
EMBED_BACKFILL_INTERVAL_S=300    # default: 300 — seconds between backfill passes

# --- Routing behaviour ---
PG_TIMEOUT_S=2.0                 # default: 2.0 — statement timeout for tier queries
LEXICAL_MIN_SCORE=               # default: 0.75 — minimum lexical suggestion score
SEMANTIC_MIN_SCORE=0.5           # default: 0.5 — minimum semantic suggestion score
EXACT_VARIANT_MAX_WORDS=6        # default: 6 — word cap on separator-variant expansion
LEXICAL_CANDIDATE_KEYS=            # default: 20 — keys taken from the in-memory fuzzy index
KEY_INDEX_REFRESH_INTERVAL_S=      # default: 300 — how often the fuzzy key index reloads

# --- Container ---
PORT=8000                        # default: 8000 — port the image's uvicorn binds
